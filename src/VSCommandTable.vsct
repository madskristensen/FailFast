	<Commands package="FailFast">
		<Buttons>
			<Button guid="FailFast" id="ToggleFailFastCommand" priority="0xFFFF" type="Button">
				<Parent guid="VSMainMenu" id="Build.MiscGroup" />
				<CommandFlag>DefaultInvisible</CommandFlag>
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>Stop Build on First Error</ButtonText>
					<LocCanonicalName>.FailFast.StopBuildOnFirstError</LocCanonicalName>
				</Strings>
			</Button>
		</Buttons>
	</Commands>

	<VisibilityConstraints>
		<VisibilityItem guid="FailFast" id="ToggleFailFastCommand" context="UICONTEXT_SolutionHasMultipleProjects" />
	</VisibilityConstraints>

	<Symbols>
		<GuidSymbol name="FailFast" value="{35066804-bfb3-4363-9dff-807d8cfb29d6}">
